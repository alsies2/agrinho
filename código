<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AgroSustentável Brasil</title>
    <style>
        /* Configurações Globais e Paleta de Cores */
        :root {
            --verde-principal: #2E7D32;
            --verde-escuro: #1B5E20;
            --azul-destaque: #1565C0;
            --amarelo-fundo: #FFFDF0; /* Amarelo claro e suave para o fundo */
            --branco: #FFFFFF;
            --texto-escuro: #263238;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 0;
            background-color: var(--amarelo-fundo);
            color: var(--texto-escuro);
            line-height: 1.6;
        }

        /* Cabeçalho */
        header {
            background-color: var(--verde-principal);
            color: var(--branco);
            padding: 20px 0;
            text-align: center;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }

        header h1 {
            margin: 0;
            font-size: 2.5rem;
        }

        header p {
            margin: 5px 0 0 0;
            font-size: 1.1rem;
            color: #E8F5E9;
        }

        /* Seção de Destaque (Hero) */
        .hero {
            background-color: var(--azul-destaque);
            color: var(--branco);
            padding: 50px 20px;
            text-align: center;
        }

        .hero h2 {
            margin: 0 0 15px 0;
            font-size: 2rem;
        }

        .hero p {
            max-width: 800px;
            margin: 0 auto;
            font-size: 1.2rem;
        }

        /* Conteúdo Principal */
        .container {
            max-width: 1100px;
            margin: 40px auto;
            padding: 0 20px;
        }

        /* Alinhamento correto do título sem usar a tag antiga <center> */
        .titulo-container {
            text-align: center;
            margin-bottom: 30px;
        }

        .secao-titulo {
            color: var(--verde-escuro);
            font-size: 1.8rem;
            border-bottom: 3px solid var(--azul-destaque);
            display: inline-block;
            padding-bottom: 5px;
            margin: 0;
        }

        /* Grid de Cards Informativos */
        .grid-sustentavel {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 25px;
            margin-top: 20px;
        }

