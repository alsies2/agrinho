<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Página Front-end Simples</title>
    
    <style>
        /* CSS: Estiliza a página */
        body {
            font-family: Arial, sans-serif;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100vh;
            margin: 0;
            background-color: #f4f4f9;
            transition: background-color 0.5s ease;
        }

        h1 {
            color: #333;
        }

        p {
            color: #666;
            margin-bottom: 20px;
        }

        button {
            padding: 10px 20px;
            font-size: 16px;
            color: white;
            background-color: #007bff;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            transition: background-color 0.3s;
        }

        button:hover {
            background-color: #0056b3;
        }
    </style>
</head>
<body>

    <h1 id="titulo">Olá, Mundo!</h1>
    <p>Este é um exemplo básico de HTML, CSS e JavaScript.</p>
    <button onclick="mudarCor()">Clique em mim</button>

    <script>
        /* JavaScript: Adiciona comportamento */
        function mudarCor() {
            // Gera uma cor hexadecimal aleatória
            const corAleatoria = '#' + Math.floor(Math.random()*16777215).toString(16);
            
            // Muda a cor de fundo da página
            document.body.style.backgroundColor = corAleatoria;
            
            // Muda o texto do título
            document.getElementById('titulo').innerText = "Cor alterada com sucesso!";
        }
    </script>

</body>
</html>
